    ''' <summary>The vertex text of VS record <paramref name="rec"/> (the shader's VS; the 8 VS of the default chain are one text).</summary>
    Friend Function VertexOf(rec As UInteger) As String
        Return Fo4GBufferSource.Header430 & Gl43.ClipGlsl & D3d11SemanticsSource.Glsl & Literals & VertexStages(rec).Fn & AppVertexFoot
    End Function

    ''' <summary>The fragment text of PS record <paramref name="rec"/>.</summary>
    Friend Function FragmentOf(rec As UInteger) As String
        Dim p = PixelShaders(rec)
        Return Fo4GBufferSource.Header430 & D3d11SemanticsSource.Glsl & Literals & PsGlobals & p.Fn & p.Entry
    End Function

    ''' <summary>The compute text of CS record <paramref name="rec"/>.</summary>
    Friend Function ComputeOf(rec As UInteger) As String
        Return Fo4GBufferSource.Header430 & D3d11SemanticsSource.Glsl & Literals & ComputeStages(rec).Fn & AppComputeEntry
    End Function

    ''' <summary>Why the preview cannot run image-space record <paramref name="rec"/> (a declared gap), empty when it can.</summary>
    Friend Function GapOf(rec As UInteger) As String
        If PixelShaders.ContainsKey(rec) Then Return PixelShaders(rec).Gap
        If VertexStages.ContainsKey(rec) Then Return VertexStages(rec).Gap
        Return ComputeStages(rec).Gap
    End Function

