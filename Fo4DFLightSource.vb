        {&H00000000UI, New GlslVertexStage(Block, 3071, "Fo4DflVs_rec3071", "", False, "", "", False, Fo4CpuRouteLayout.None, "")}}

    ''' <summary>APP (rev-E08): the PS whose shadow takes the rig's Darkness (the sun's shadowed techniques the rig draws,
    ''' Fo4DeferredLightLaw.SunTechnique(True, ambient)).</summary>
    Friend ReadOnly AppShadowDarknessPs As UInteger() = {&H01200202UI, &H01220202UI}

#If DEBUG Then
    ''' <summary>APP (rev-E08): the one line of each of those PS the generator rewrote for the rig's Darkness - (function, the
    ''' engine's line, the app's line) - so a gate rebuilds the engine's text exactly (AnchoredReplace app -&gt; engine).</summary>
    Friend ReadOnly AppShadowDarknessLines As (Fn As String, Engine As String, App As String)() = {
        ("Fo4DflPs_rec3227", "    r1.w = r2.y * r1.w + 1.0;                                                             // 1165  mad r1.w, r2.y, r1.w, l(1.000000)", "    r1.w = (r2.y * (1.0 - AppShadowLift)) * r1.w + 1.0;   // APP rev-E08 mix(1, s, D), D = 1 - AppShadowLift |1165  mad r1.w, r2.y, r1.w, l(1.000000)"),
        ("Fo4DflPs_rec3232", "    r1.w = r2.z * r1.w + 1.0;                                                             // 1181  mad r1.w, r2.z, r1.w, l(1.000000)", "    r1.w = (r2.z * (1.0 - AppShadowLift)) * r1.w + 1.0;   // APP rev-E08 mix(1, s, D), D = 1 - AppShadowLift |1181  mad r1.w, r2.z, r1.w, l(1.000000)")}
#End If

    ''' <summary>APP (26-oct-2026): the one line of each PS of AppShadowDarknessPs the generator rewrote for the rig's Shadow Bias -
    ''' the receiver's 0.275 times (1 + AppShadowBiasGrowth) - as (function, the engine's line, the app's line), so a gate rebuilds the
    ''' engine's text exactly (AnchoredReplace app -&gt; engine).</summary>
    Friend ReadOnly AppShadowBiasLines As (Fn As String, Engine As String, App As String)() = {
        ("Fo4DflPs_rec3227", "        r2.y = -r6.z * FO4_L_0_275 + r2.y;                                                // 1086  mad r2.y, -r6.z, l(0.275000), r2.y", "        r2.y = -r6.z * (FO4_L_0_275 * (1.0 + AppShadowBiasGrowth)) + r2.y;   // APP shadow bias: 0.275 x b, AppShadowBiasGrowth = b - 1 |1086  mad r2.y, -r6.z, l(0.275000), r2.y"),
        ("Fo4DflPs_rec3232", "        r6.w = -r7.z * FO4_L_0_275 + r6.w;                                                // 1101  mad r6.w, -r7.z, l(0.275000), r6.w", "        r6.w = -r7.z * (FO4_L_0_275 * (1.0 + AppShadowBiasGrowth)) + r6.w;   // APP shadow bias: 0.275 x b, AppShadowBiasGrowth = b - 1 |1101  mad r6.w, -r7.z, l(0.275000), r6.w")}

    ''' <summary>The engine's VS of a light technique (SetupTechnique 0x142246B40 -&gt; 0x142271B30): 0, the one VS (rec3071).</summary>
    Friend Function VertexShaderId(technique As UInteger) As UInteger
        Return 0UI
    End Function

    ''' <summary>The engine's PS of a light technique (0x142271B40): a = (t AND 0x140) ? t AND 0xF801257F : t; (a AND 0x4003A) ? a :
    ''' a AND 0xFC07FF7F.</summary>
    Friend Function PixelShaderId(technique As UInteger) As UInteger
        Dim a = If((technique And &H140UI) <> 0UI, technique And &HF801257FUI, technique)
        Return If((a And &H4003AUI) <> 0UI, a, a And &HFC07FF7FUI)
    End Function

    ''' <summary>The programs of the technique that are NOT in the shader cache (or are a declared gap: Fn empty), named; Nothing when
    ''' both are there (BeginTechnique 0x142231AE0; HS = DS = 0, 0x142246B64..B73).</summary>
    Friend Function MissingEnginePrograms(technique As UInteger) As String
        Dim ps = PixelShaderId(technique)
        If Not PixelShaders.ContainsKey(ps) Then Return $"pixel shader 0x{ps:X8}"
        If PixelShaders(ps).Fn = "" Then Return $"pixel shader 0x{ps:X8} (not transcribed: {PixelShaders(ps).Gap})"
        Return Nothing
    End Function

    ''' <summary>The vertex text of the light VS: Gl43.ClipGlsl, the D3D semantics, the literals, the class block and the app foot.</summary>
    Friend Function VertexOf(vs As UInteger) As String
        Return Fo4GBufferSource.Header430 & Gl43.ClipGlsl & D3d11SemanticsSource.Glsl & Literals & VertexStages(vs).Resources & VertexStages(vs).Fn & AppVertexFoot
    End Function

    ''' <summary>The fragment text of PS <paramref name="ps"/>.</summary>
    Friend Function FragmentOf(ps As UInteger) As String
        Dim p = PixelShaders(ps)
        Return Fo4GBufferSource.Header430 & D3d11SemanticsSource.Glsl & Literals & PsGlobals & p.Resources & p.Fn & p.Entry
    End Function

