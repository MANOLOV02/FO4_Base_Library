    ''' <summary>THE ONE RULE of an effect draw's vertex route (as SseLightingSource.EffectiveCpuLayout): the CPU-route layout of VS
    ''' <paramref name="vs"/> when the draw takes the CPU route, None for a rigid VS or on the GPU route.</summary>
    Friend Function EffectiveCpuLayout(vs As UInteger, cpuRoute As Boolean) As Fo4CpuRouteLayout
        If Not cpuRoute Then Return Fo4CpuRouteLayout.None
        Dim v As GlslVertexStage = Nothing
        Return If(VertexStages.TryGetValue(vs, v), v.CpuLayout, Fo4CpuRouteLayout.None)
    End Function

    ''' <summary>The vertex text of VS <paramref name="vs"/> on a vertex route: Gl43.ClipGlsl, the D3D semantics, the literals, AppSkinLaw
    ''' where rule D2 put it, the resources, the class block and the app foot (<paramref name="surface"/>: the foot of the translucent
    ''' decals' base surface, AppSurfaceVertexFoot). <paramref name="positionCapture"/>: Gl43.ClipGlslCapture instead (gl_Position = the
    ''' D3D clip o0, for a transform-feedback capture: the gates). The surface foot skins the app's normal with AppSkinLaw (Glsl, once:
    ''' where rule D2 did not put it already, and SseGpuBlendGlsl).</summary>
    Friend Function VertexOf(vs As UInteger, cpuRoute As Boolean, Optional surface As Boolean = False, Optional positionCapture As Boolean = False) As String
        Dim v = VertexStages(vs)
        Dim foot = If(surface, AppSkinLaw.SseGpuBlendGlsl & AppSurfaceVertexFoot, AppVertexFoot)
        Dim clip = If(positionCapture, Gl43.ClipGlslCapture, Gl43.ClipGlsl)
        ' SseEffectTechnique.GateVertexTextMutants: the Debug gates' perturbations of the position path (rev-16); the text unchanged otherwise.
        If EffectiveCpuLayout(vs, cpuRoute) <> Fo4CpuRouteLayout.None Then
            Return SseEffectTechnique.GateVertexTextMutants(Fo4GBufferSource.Header430 & clip & D3d11SemanticsSource.Glsl & Literals & If(v.CpuSkinLaw OrElse surface, AppSkinLaw.Glsl, "") & v.CpuResources & v.CpuFn & foot)
        End If
        Return SseEffectTechnique.GateVertexTextMutants(Fo4GBufferSource.Header430 & clip & D3d11SemanticsSource.Glsl & Literals & If(v.SkinLaw OrElse surface, AppSkinLaw.Glsl, "") & v.Resources & v.Fn & foot)
    End Function

    ''' <summary>The fragment text of PS <paramref name="ps"/>: the D3D semantics, the literals, the PS globals, the post-off display tail
    ''' the entry reads (LegacyDisplaySource), the resources, the class block and the app entry.</summary>
    Friend Function FragmentOf(ps As UInteger) As String
        Dim p = PixelShaders(ps)
        Return Fo4GBufferSource.Header430 & D3d11SemanticsSource.Glsl & Literals & PsGlobals & LegacyDisplaySource.Tonemap_Glsl & p.Resources & p.Fn & p.Entry
    End Function

