// bone indices (vboBoneIndices, 4 bytes), 17 = the bone weights (vboBoneWeights, 4 floats); the palette: SSBO 0 (SseGpuBlendGlsl).
layout(std430, binding = 15) readonly buffer AppSurfaceNormals { float appSurfaceNormalF[]; };
layout(std430, binding = 16) readonly buffer AppSurfaceBoneIndices { uint appSurfaceBoneIdx[]; };
layout(std430, binding = 17) readonly buffer AppSurfaceBoneWeights { vec4 appSurfaceBoneWgt[]; };
uniform mat3 appModelNormal;
out vec3 appNormal;
void main()
{
    engine_main();
    appEffectEditFoot();
    int i = gl_VertexID;
    vec3 nrm = vec3(appSurfaceNormalF[3 * i], appSurfaceNormalF[3 * i + 1], appSurfaceNormalF[3 * i + 2]);
    if (bGPUSkinning)
    {
        uint b = appSurfaceBoneIdx[i];
        ivec4 idx = ivec4(int(b & 0xFFu), int((b >> 8) & 0xFFu), int((b >> 16) & 0xFFu), int(b >> 24));
