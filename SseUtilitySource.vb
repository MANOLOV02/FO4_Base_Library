    ''' <summary>THE ONE RULE of a utility draw's vertex route (as Fo4UtilitySource.EffectiveCpuLayout): the CPU-route layout of VS
    ''' <paramref name="vs"/> when the draw takes the CPU route, None for a rigid VS or on the GPU route.</summary>
    Friend Function EffectiveCpuLayout(vs As UInteger, cpuRoute As Boolean) As Fo4CpuRouteLayout
        If Not cpuRoute Then Return Fo4CpuRouteLayout.None
        Dim v As GlslVertexStage = Nothing
        Return If(VertexStages.TryGetValue(vs, v), v.CpuLayout, Fo4CpuRouteLayout.None)
    End Function

    ''' <summary>The vertex text of VS <paramref name="vs"/> on a vertex route: Gl43.ClipGlsl, the D3D semantics, the literals, AppSkinLaw
    ''' where rule D2 put it, the resources, the class block and the app foot. <paramref name="positionCapture"/>: Gl43.ClipGlslCapture
    ''' instead (gl_Position = the D3D clip o0, for a transform-feedback capture: the gates).</summary>
    Friend Function VertexOf(vs As UInteger, cpuRoute As Boolean, Optional positionCapture As Boolean = False) As String
        Dim v = VertexStages(vs)
        Dim clip = If(positionCapture, Gl43.ClipGlslCapture, Gl43.ClipGlsl)
        If EffectiveCpuLayout(vs, cpuRoute) <> Fo4CpuRouteLayout.None Then
            Return Fo4GBufferSource.Header430 & clip & D3d11SemanticsSource.Glsl & Literals & If(v.CpuSkinLaw, AppSkinLaw.Glsl, "") & v.CpuResources & v.CpuFn & AppVertexFoot
        End If
        Return Fo4GBufferSource.Header430 & clip & D3d11SemanticsSource.Glsl & Literals & If(v.SkinLaw, AppSkinLaw.Glsl, "") & v.Resources & v.Fn & AppVertexFoot
    End Function

    ''' <summary>The fragment text of PS <paramref name="ps"/>: the D3D semantics, the literals, the PS globals, the resources, the class
    ''' block and the app entry of its output shape.</summary>
    Friend Function FragmentOf(ps As UInteger) As String
        Dim p = PixelShaders(ps)
        Return Fo4GBufferSource.Header430 & D3d11SemanticsSource.Glsl & Literals & PsGlobals & p.Resources & p.Fn & p.Entry
    End Function

    ''' <summary>The fragment of a technique whose PS is null (SseUtilityTechnique.PixelShaderNull): no fragment output, the rasterised
    ''' depth only (AppNullFragment).</summary>
    Friend Function NullFragment() As String
        Return Fo4GBufferSource.Header430 & AppNullFragment
    End Function

