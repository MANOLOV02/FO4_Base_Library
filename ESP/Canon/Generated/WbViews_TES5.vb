        ''' <summary>Agrega un elemento vacío al final y lo devuelve.</summary>
        Public Function AgregarActorEffects() As IRace_ActorEffects Implements IRace.AgregarActorEffects
            Dim cont = Asegurar("Actor Effects")
            If cont Is Nothing Then Return Nothing
            Dim nuevo = WbEdit.AgregarElemento(cont, Context)
            If nuevo Is Nothing Then Return Nothing
            Return New RaceSSE_ActorEffects(nuevo, Context, Resolver)
        End Function

        ''' <summary>Saca el elemento que está en esa posición.</summary>
        Public Function QuitarActorEffects(indice As Integer) As Boolean Implements IRace.QuitarActorEffects
            Dim cont = If(Node Is Nothing, Nothing, Node.ByFieldPath("Actor Effects"))
