    ''' <summary>The engine's VS of a utility technique (SetupTechnique 0x1422409A0 -&gt; 0x1422776C0): t AND 0xF7A5FFDF (drops 5, 17, 19,
    ''' 20, 22, 27).</summary>
    Friend Function VertexShaderId(technique As UInteger) As UInteger
        Return technique And &HF7A5FFDFUI
    End Function

    ''' <summary>The engine's PS of a utility technique (0x1422776D0): with bits 21 and 23 both set (MERGE_INSTANCED) the mask
    ''' 0xFF5FFB8B, else 0xFF7FFB8B; with bit 29 (VATS_DEBUG_COLOR) bit 3 is dropped too (0x...83).</summary>
    Friend Function PixelShaderId(technique As UInteger) As UInteger
        Dim both = (technique And &HA00000UI) = &HA00000UI
        Dim vats = (technique And &H20000000UI) <> 0UI
        Dim m = If(both, If(vats, &HFF5FFB83UI, &HFF5FFB8BUI), If(vats, &HFF7FFB83UI, &HFF7FFB8BUI))
        Return technique And m
    End Function

    ''' <summary>SetupTechnique binds NO pixel shader (PSSetShader(NULL), 0x14181DFB0) for a depth / shadow-map technique (t AND 0x6000)
    ''' without ALPHA_TEST, SHADOWMAP_PB or ADDITIONAL_ALPHA_MASK (t AND 0x10010080 = 0; 0x142240C82..C91). The PS of the technique must
    ''' still be in the cache (BeginTechnique 0x142231AE0 looks both up: MissingEnginePrograms).</summary>
    Friend Function PixelShaderNull(technique As UInteger) As Boolean
        Return (technique And &H6000UI) <> 0UI AndAlso (technique And &H10010080UI) = 0UI
    End Function

    ''' <summary>The programs of the technique that are NOT in the shader cache, named for the frame's notice; Nothing when both are
    ''' there (BeginTechnique 0x142231AE0: VS and PS required; HS = DS = 0, 0x1422409BF..9CE).</summary>
    Friend Function MissingEnginePrograms(technique As UInteger) As String
        Dim ps = PixelShaderId(technique), vs = VertexShaderId(technique)
        Dim psIn = PixelShaders.ContainsKey(ps), vsIn = VertexStages.ContainsKey(vs)
        If psIn AndAlso vsIn Then Return Nothing
        If Not psIn AndAlso Not vsIn Then Return $"pixel shader 0x{ps:X8} and vertex shader 0x{vs:X8}"
        Return If(psIn, $"vertex shader 0x{vs:X8}", $"pixel shader 0x{ps:X8}")
    End Function

    ''' <summary>Why the preview cannot draw technique <paramref name="technique"/> although the engine has its programs (a runtime
    ''' resource a stage reads); empty when it can. The null PS of PixelShaderNull is not drawn, so its gap does not count.</summary>
    Friend Function GapOf(technique As UInteger) As String
        Dim v = VertexStages(VertexShaderId(technique)).Gap
        Dim p = If(PixelShaderNull(technique), "", PixelShaders(PixelShaderId(technique)).Gap)
        Return If(p <> "" AndAlso v <> "", p & "; " & v, p & v)
    End Function

    ''' <summary>THE ONE RULE of a utility draw's vertex route (as Fo4GBufferSource.EffectiveCpuLayout): the CPU-route layout of VS
    ''' <paramref name="vs"/> when the draw takes the CPU route, None for a rigid VS or on the GPU route.</summary>
    Friend Function EffectiveCpuLayout(vs As UInteger, cpuRoute As Boolean) As Fo4CpuRouteLayout
        If Not cpuRoute Then Return Fo4CpuRouteLayout.None
        Dim v As (Record As Integer, Fn As String, Resources As String, SkinLaw As Boolean, CpuFn As String, CpuResources As String, CpuSkinLaw As Boolean, CpuLayout As Fo4CpuRouteLayout, Gap As String) = Nothing
        Return If(VertexStages.TryGetValue(vs, v), v.CpuLayout, Fo4CpuRouteLayout.None)
    End Function

    ''' <summary>The vertex text of VS <paramref name="vs"/> on a vertex route: Gl43.ClipGlsl, the D3D semantics, the literals, AppSkinLaw
    ''' where rule D2 put it, the resources, the class block and the app foot.</summary>
    Friend Function VertexOf(vs As UInteger, cpuRoute As Boolean) As String
        Dim v = VertexStages(vs)
        If EffectiveCpuLayout(vs, cpuRoute) <> Fo4CpuRouteLayout.None Then
            Return Fo4GBufferSource.Header430 & Gl43.ClipGlsl & D3d11SemanticsSource.Glsl & Literals & If(v.CpuSkinLaw, AppSkinLaw.Glsl, "") & v.CpuResources & v.CpuFn & AppVertexFoot
        End If
        Return Fo4GBufferSource.Header430 & Gl43.ClipGlsl & D3d11SemanticsSource.Glsl & Literals & If(v.SkinLaw, AppSkinLaw.Glsl, "") & v.Resources & v.Fn & AppVertexFoot
    End Function

    ''' <summary>The fragment text of PS <paramref name="ps"/>: the D3D semantics, the literals, the PS globals, the resources, the class
    ''' block and the app entry of its output shape.</summary>
    Friend Function FragmentOf(ps As UInteger) As String
        Dim p = PixelShaders(ps)
        Return Fo4GBufferSource.Header430 & D3d11SemanticsSource.Glsl & Literals & PsGlobals & p.Resources & p.Fn & p.Entry
    End Function

    ''' <summary>The fragment of a technique whose PS is null (PixelShaderNull): no fragment output, the rasterised depth only, and the
    ''' edit view's zap (AppNullFragment).</summary>
    Friend Function NullFragment() As String
        Return Fo4GBufferSource.Header430 & AppNullFragment
    End Function

