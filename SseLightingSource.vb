    ''' <summary>THE ONE RULE of a lighting draw's vertex route (as Fo4UtilitySource.EffectiveCpuLayout): the CPU-route layout of VS
    ''' <paramref name="vs"/> when the draw takes the CPU route, None for a rigid VS or on the GPU route.</summary>
    Friend Function EffectiveCpuLayout(vs As UInteger, cpuRoute As Boolean) As Fo4CpuRouteLayout
        If Not cpuRoute Then Return Fo4CpuRouteLayout.None
        Dim v As GlslVertexStage = Nothing
        Return If(VertexStages.TryGetValue(vs, v), v.CpuLayout, Fo4CpuRouteLayout.None)
    End Function

    ''' <summary>The vertex text of VS <paramref name="vs"/> on a vertex route: Gl43.ClipGlsl, the D3D semantics, the literals, AppSkinLaw
    ''' where rule D2 put it, the resources, the class block and the app foot. <paramref name="positionCapture"/>: Gl43.ClipGlslCapture
    ''' instead (gl_Position = the D3D clip o0, for a transform-feedback capture: the gates).</summary>
    Friend Function VertexOf(vs As UInteger, cpuRoute As Boolean, Optional positionCapture As Boolean = False) As String
        Dim v = VertexStages(vs)
        ' The eye's VS (type 16, bits 24..29 of the key, SseRenderPassLaw.LitVsKey) writes TEXCOORD6: the app's foot has its branch (Q-ojo (b)).
        Dim eyeVs = If(((vs >> 24) And &H3FUI) = &H10UI, "#define APP_LIT_EYE_VS" & vbLf, "")
        Dim clip = If(positionCapture, Gl43.ClipGlslCapture, Gl43.ClipGlsl)
        If EffectiveCpuLayout(vs, cpuRoute) <> Fo4CpuRouteLayout.None Then
            Return Fo4GBufferSource.Header430 & eyeVs & clip & D3d11SemanticsSource.Glsl & Literals & If(v.CpuSkinLaw, AppSkinLaw.Glsl, "") & v.CpuResources & v.CpuFn & AppVertexFoot
        End If
        Return Fo4GBufferSource.Header430 & eyeVs & clip & D3d11SemanticsSource.Glsl & Literals & If(v.SkinLaw, AppSkinLaw.Glsl, "") & v.Resources & v.Fn & AppVertexFoot
    End Function

    ''' <summary>The fragment text of PS <paramref name="ps"/>: the D3D semantics, the literals, the PS globals, the post-off display tail
    ''' the entry reads (LegacyDisplaySource), the resources, the class block and the app entry of its output shape.</summary>
    Friend Function FragmentOf(ps As UInteger) As String
        Dim p = PixelShaders(ps)
        Return Fo4GBufferSource.Header430 & D3d11SemanticsSource.Glsl & Literals & PsGlobals & LegacyDisplaySource.Tonemap_Glsl & p.Resources & p.Fn & p.Entry
    End Function

