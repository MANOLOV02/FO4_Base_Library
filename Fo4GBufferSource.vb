    Friend Const VsCb10 As String = "// cb10 = the bone palette (propuesta FINAL 3.6 / 3.8, E2): FO4 binds 3n rows for n bones (0x1422303D0, pool 0x1422304B3..4E4)
// to a VS that declares CB10[180]; the declared size is not copied: an unsized SSBO of the bound rows, a read past them is 0
// (D3D11.3 7.5, with respect to the bound buffer). Written by RenderableMesh.BindEnginePalette (binding 10).
layout(std430, binding = 10) readonly buffer Fo4Cb10 { vec4 cb10_rows[]; };
vec4 d3d_cb10(int i) { return (i >= 0 && i < cb10_rows.length()) ? cb10_rows[i] : vec4(0.0); }   // D3D11.3 7.5: bound size
"
    Friend Const VsCb13 As String = "// cb13 of the VS (INSTANCED): dynamically indexed instance rows; the VS slot-13 binder is runtime-only and not traced (binder
// OPEN, 0 corpus shapes). A read past the bound range returns 0 (D3D11.3 7.5).
layout(std430, binding = 33) readonly buffer Fo4GVsCB13 { vec4 vscb13_rows[]; };
vec4 d3d_cb13(int row) { uint r = uint(row); return r < uint(vscb13_rows.length()) ? vscb13_rows[r] : vec4(0.0); }
"
    Friend Const VsRawT4 As String = "// The VS buffer slots of the closed list (dcl_resource census of the 315 VS + tail): raw t4..t7, structured t4..t8.
