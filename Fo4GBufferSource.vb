    ''' <summary>The BSEffect decals in the G-buffer lists (notas 6): effect technique -&gt; (record, function text, name).</summary>
    Friend ReadOnly EffectDecals As New Dictionary(Of UInteger, (Record As Integer, Fn As String, FnName As String)) From {
        {&H10000405UI, (0971, Fo4GDecal_rec0971, "Fo4GDecal_rec0971")},
        {&H10000025UI, (0968, Fo4GDecal_rec0968, "Fo4GDecal_rec0968")}}

    ''' <summary>The fragment text of a record, as the transcription's assembly table builds it, with the app entry.
    ''' <paramref name="earlyTests"/> = False leaves out the record's forceEarlyDepthStencil (the translucent decals' base pass,
    ''' Fo4DeferredPrograms.DecalBaseProgram: there the depth write has to follow the PS's kill).</summary>
    Friend Function FragmentOf(psId As UInteger, Optional earlyTests As Boolean = True) As String
        Dim r = Records(psId)
        Return Header430 & If(r.EarlyZ AndAlso earlyTests, EarlyFragmentTests, "") & D3d11SemanticsSource.Glsl & Literals & Common & r.Resources & r.Fn &
               vbLf & "#define FO4_GBUF_ENTRY " & r.FnName & vbLf & AppMain
    End Function

    ''' <summary>GATE ONLY: the transcribed BSEffect decal PS, oracle of Fragment_FO4's BGEM path drawn into the G-buffer (one runtime owner of the BGEM law).</summary>
    Friend Function EffectDecalFragmentOf(effectTechnique As UInteger) As String
        Dim r = EffectDecals(effectTechnique)
        Return Header430 & D3d11SemanticsSource.Glsl & Literals & EffectCommon & r.Fn & vbLf & "#define FO4_GDECAL_ENTRY " & r.FnName & vbLf & EffectAppMain
    End Function

