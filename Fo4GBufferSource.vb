    Friend Const AppVertexFoot As String = "// APP FOOT of the engine VS (ola 2, propuesta H6): the transcribed main is engine_main; the edit views' per-vertex data from
// the app's own buffers (location 14 = mask, 15 = bone weight; RenderableMesh.EngineVao).
layout(location = 14) in float appVertexMask;
layout(location = 15) in float appVertexWeight;
uniform bool bApplyZap;
uniform bool bShowMask;
uniform bool bShowWeight;
out float maskFactor;
out vec3 weightColor;
flat out int ZappedVert;
" & AppEditViewsSource.ColorRamp & "
void main()
{
    engine_main();
    ZappedVert = (bApplyZap && appVertexMask < 0.0) ? 1 : 0;
    maskFactor = !bShowMask ? 1.0 : (ZappedVert == 1 ? 1.0 - (-appVertexMask) / 1.5 : 1.0 - appVertexMask / 1.5);
    weightColor = bShowWeight ? colorRamp(appVertexWeight) : vec3(1.0);
}
"
    Friend Const AppTessControlFoot As String = "// APP FOOT of the engine HS (ola 2): the edit views' varyings pass through the control points.
in float maskFactor[];
in vec3 weightColor[];
flat in int ZappedVert[];
out float tcs_maskFactor[];
out vec3 tcs_weightColor[];
out int tcs_ZappedVert[];
void main()
{
    engine_main();
    tcs_maskFactor[gl_InvocationID] = maskFactor[gl_InvocationID];
    tcs_weightColor[gl_InvocationID] = weightColor[gl_InvocationID];
    tcs_ZappedVert[gl_InvocationID] = ZappedVert[gl_InvocationID];
}
"
    Friend Const AppTessEvalFoot As String = "// APP FOOT of the engine DS (ola 2): the edit views' varyings at the domain point (barycentric, as the DS interpolates).
in float tcs_maskFactor[];
in vec3 tcs_weightColor[];
in int tcs_ZappedVert[];
out float maskFactor;
out vec3 weightColor;
flat out int ZappedVert;
void main()
{
    engine_main();
    vec3 b = gl_TessCoord;
    maskFactor = b.x * tcs_maskFactor[0] + b.y * tcs_maskFactor[1] + b.z * tcs_maskFactor[2];
    weightColor = b.x * tcs_weightColor[0] + b.y * tcs_weightColor[1] + b.z * tcs_weightColor[2];
    ZappedVert = max(tcs_ZappedVert[0], max(tcs_ZappedVert[1], tcs_ZappedVert[2]));
}
"
