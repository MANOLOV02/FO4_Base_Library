    ''' <summary>The engine stages of a tuple (SetShaders 0x14181D4A0): the VS with the app foot, and the HS / DS when the technique
    ''' tessellates (topology 0x23, 0x14181D60E). Throws when a stage is not transcribed (its reason) or the HS is not in the cache
    ''' (A1, StaleHullTechniques). Provides = the varyings the last stage writes (for the decal base surface).
    ''' <paramref name="cpuRoute"/> = True: the skinned VS's CPU-route variant (the vertex stream carries the CPU's skinning,
    ''' Fo4EngineVertexPacker.PackCpuRoute); a rigid VS has one route and ignores it. The VS and the DS carry Gl43.ClipGlsl (their
    ''' gl_Position = gl43ClipToGl(o0)); <paramref name="positionCapture"/> = True: the VS with Gl43.ClipGlslCapture instead, for the
    ''' transform-feedback capture of the D3D clip position (Fo4DeferredPrograms.EnginePositionProgram).</summary>
    Friend Function StageOf(vs As UInteger, hs As UInteger, ds As UInteger, Optional cpuRoute As Boolean = False,
                            Optional positionCapture As Boolean = False) As (Vertex As String, Control As String, Evaluation As String)
        Dim v As (Record As Integer, Fn As String, Resources As String, SkinLaw As Boolean, NotTranscribed As String, CpuFn As String, CpuResources As String, CpuSkinLaw As Boolean, CpuLayout As Fo4CpuRouteLayout) = Nothing
        If Not VertexStages.TryGetValue(vs, v) Then Throw New InvalidOperationException($"VS 0x{vs:X8} is not in the b09 shader cache")
        If v.NotTranscribed <> "" Then Throw New InvalidOperationException($"VS 0x{vs:X8} (rec{v.Record}) not transcribed: {v.NotTranscribed}")
        Dim clip = If(positionCapture, Gl43.ClipGlslCapture, Gl43.ClipGlsl)
        Dim vertex = If(EffectiveCpuLayout(vs, cpuRoute) <> Fo4CpuRouteLayout.None,
                        Header430 & clip & D3d11SemanticsSource.Glsl & StageLiterals & If(v.CpuSkinLaw, AppSkinLaw.Glsl, "") & v.CpuResources & v.CpuFn & AppVertexFoot,
                        Header430 & clip & D3d11SemanticsSource.Glsl & StageLiterals & If(v.SkinLaw, AppSkinLaw.Glsl, "") & v.Resources & v.Fn & AppVertexFoot)
        If hs = 0UI Then Return (vertex, Nothing, Nothing)
        Dim h As (Record As Integer, Fn As String, NotTranscribed As String) = Nothing
        If Not HullStages.TryGetValue(hs, h) Then Throw New InvalidOperationException($"HS 0x{hs:X8} is not in the cache: the engine keeps the HS / DS a previous draw left bound (A1, 0x142231CAB / CC4)")
        Dim d = DomainStages(ds)
        If h.NotTranscribed <> "" OrElse d.NotTranscribed <> "" Then Throw New InvalidOperationException($"HS / DS 0x{hs:X8} not transcribed: {h.NotTranscribed}{d.NotTranscribed}")
        Dim control = Header430 & D3d11SemanticsSource.Glsl & StageLiterals & h.Fn & AppTessControlFoot
#If DEBUG Then
        ' GATE (ShadowGate --fo4-hs-law, gates-v5): the HS value oracle's mutants of the transcribed HS - the dismember fork's clamp
        ' dropped, the dismember control point phase's select swapped, the literal fork phase's 3 instances run as 2
        If Fo4GBufferConstants.GateMutantOn("hs-no-clamp") Then control = control.Replace("d3d_min(r0.x, 16.0)", "r0.x")
        If Fo4GBufferConstants.GateMutantOn("hs-cp-select-swap") Then control = control.Replace("mix(r0.yzw, DismemberAdjustedHitLoc.xyz,", "mix(DismemberAdjustedHitLoc.xyz, r0.yzw,")
        If Fo4GBufferConstants.GateMutantOn("hs-fork-short") Then control = control.Replace("for (int i = 0; i < 3; i++)", "for (int i = 0; i < 2; i++)")
#End If
        Return (vertex, control,
                Header430 & Gl43.ClipGlsl & D3d11SemanticsSource.Glsl & StageLiterals & d.Resources & d.Fn & AppTessEvalFoot)
    End Function

    ''' <summary>A z-prepass VS of the fxp tail (0x14181F290): 3928 rigid, 3929 alpha test (3931 / 3932 / 3934 / 3935 transcribed too).</summary>
    Friend Function PrepassVertex(rec As Integer) As String
        Select Case rec
            Case 3928 : Return Header430 & Gl43.ClipGlsl & D3d11SemanticsSource.Glsl & StageLiterals & ProgramText("Fo4GPre_rec3928")
            Case 3929 : Return Header430 & Gl43.ClipGlsl & D3d11SemanticsSource.Glsl & StageLiterals & ProgramText("Fo4GPre_rec3929")
            Case 3931 : Return Header430 & Gl43.ClipGlsl & D3d11SemanticsSource.Glsl & StageLiterals & VsCb13 & ProgramText("Fo4GPre_rec3931")
            Case 3932 : Return Header430 & Gl43.ClipGlsl & D3d11SemanticsSource.Glsl & StageLiterals & VsCb13 & ProgramText("Fo4GPre_rec3932")
            Case 3934 : Return Header430 & Gl43.ClipGlsl & D3d11SemanticsSource.Glsl & StageLiterals & VsRawT4 & VsRawT5 & VsRawT6 & VsStructT7 & ProgramText("Fo4GPre_rec3934")
            Case 3935 : Return Header430 & Gl43.ClipGlsl & D3d11SemanticsSource.Glsl & StageLiterals & VsRawT4 & VsRawT5 & VsRawT6 & VsStructT7 & ProgramText("Fo4GPre_rec3935")
        End Select
        Throw New ArgumentOutOfRangeException(NameOf(rec))
    End Function

    ''' <summary>THE Z-PREPASS'S ALPHA TEST as one GLSL text (ola 7f round 2, p7f-03): the function Fo4GPre_rec3930 of the transcribed PS
    ''' 3930 (the 0x1A entry, with VS 3929), without its declarations and its main - kill = tex(t0, TEXCOORD0.xy).a x sat(TEXCOORD0.z +
    ''' cb2[0].y) - cb2[0].x &lt; 0 (0x141828F45..F8D). Its readers: the prepass's own program (PrepassFragment(3930), the whole block)
    ''' and Fallout 4's edit views (Shader_Class_Fo4EditView), which declare gbuf_TEXCOORD0, cb2_ps0 and t0 and include
    ''' D3d11SemanticsSource.Glsl: the views cut with the prepass's very text, not a copy of it.</summary>
    Friend Function PrepassAlphaKill() As String
        Dim t = ProgramText("Fo4GPre_rec3930")
        Dim i = t.IndexOf("void Fo4GPre_rec3930(", StringComparison.Ordinal)
        Dim j = t.IndexOf("void main()", StringComparison.Ordinal)
        If i < 0 OrElse j < i Then Throw New InvalidOperationException("Fo4GBufferBlocks.glsl.txt: the function of Fo4GPre_rec3930 was not found")
        Return t.Substring(i, j - i)
    End Function

    ''' <summary>A z-prepass PS of the fxp tail: 3930 (alpha test, with 3929), 3933, 3936.</summary>
    Friend Function PrepassFragment(rec As Integer) As String
        Select Case rec
            Case 3930 : Return Header430 & D3d11SemanticsSource.Glsl & StageLiterals & ProgramText("Fo4GPre_rec3930")
            Case 3933 : Return Header430 & D3d11SemanticsSource.Glsl & StageLiterals & ProgramText("Fo4GPre_rec3933")
            Case 3936 : Return Header430 & D3d11SemanticsSource.Glsl & StageLiterals & ProgramText("Fo4GPre_rec3936")
        End Select
        Throw New ArgumentOutOfRangeException(NameOf(rec))
    End Function

    ''' <summary>THE ONE RULE of a draw's vertex route (review rev-05): the CPU-route layout VS <paramref name="vs"/> is drawn with when
    ''' the draw takes the CPU route (<paramref name="cpuRoute"/> = RenderableMesh.EngineCpuRoute; True = "the CPU route, if this VS
    ''' has one"): VertexStages.CpuLayout, None for a rigid VS (one route) or on the GPU route. StageOf, the programs' route
    ''' (Fo4DeferredPrograms.RouteOf), the VAO (RenderableMesh.EngineVaoFor) and the gates read only this.</summary>
    Friend Function EffectiveCpuLayout(vs As UInteger, cpuRoute As Boolean) As Fo4CpuRouteLayout
        If Not cpuRoute Then Return Fo4CpuRouteLayout.None
        Dim v As (Record As Integer, Fn As String, Resources As String, SkinLaw As Boolean, NotTranscribed As String, CpuFn As String, CpuResources As String, CpuSkinLaw As Boolean, CpuLayout As Fo4CpuRouteLayout) = Nothing
        Return If(VertexStages.TryGetValue(vs, v), v.CpuLayout, Fo4CpuRouteLayout.None)
    End Function

    ''' <summary>The BSEffect decals in the G-buffer lists (notas 6): effect technique -&gt; (record, function text, name).</summary>
    Friend ReadOnly EffectDecals As New Dictionary(Of UInteger, (Record As Integer, Fn As String, FnName As String)) From {
        {&H10000405UI, (0971, ProgramText("Fo4GDecal_rec0971"), "Fo4GDecal_rec0971")},
        {&H10000025UI, (0968, ProgramText("Fo4GDecal_rec0968"), "Fo4GDecal_rec0968")}}

    ''' <summary>The fragment text of a record, as the transcription's assembly table builds it, with the app entry (ola 2: the
    ''' record's FO4_GBUF_IN defines and the stage inputs before the class function, which takes Fo4GBufIn).
    ''' <paramref name="earlyTests"/> = False leaves out the record's forceEarlyDepthStencil (the translucent decals' base pass,
    ''' Fo4DeferredPrograms.RecordWithoutEarlyTests: there the depth write has to follow the PS's kill).</summary>
    Friend Function FragmentOf(psId As UInteger, Optional earlyTests As Boolean = True) As String
        Dim r = Records(psId)
        Return Header430 & If(r.EarlyZ AndAlso earlyTests, EarlyFragmentTests, "") & D3d11SemanticsSource.Glsl & Literals & Common & r.Resources &
               r.InDefines & StageInputsBlock & r.Fn & vbLf & "#define FO4_GBUF_ENTRY " & r.FnName & vbLf & AppMain
    End Function

    ''' <summary>GATE ONLY: the transcribed BSEffect decal PS drawn into the G-buffer (the runtime's owner of the BGEM law is the
    ''' effect's transcribed program, Fo4EffectSource).</summary>
    Friend Function EffectDecalFragmentOf(effectTechnique As UInteger) As String
        Dim r = EffectDecals(effectTechnique)
        Return Header430 & D3d11SemanticsSource.Glsl & Literals & EffectCommon & r.Fn & vbLf & "#define FO4_GDECAL_ENTRY " & r.FnName & vbLf & EffectAppMain
    End Function

