    Friend Const AppMain As String = "// APP ENTRY (replaces the transcription's GBUF_MAIN; ola 2): the record's inputs come from the ENGINE VS by semantic
// (gbufFromStageInputs, generated per record from Fo4GBufIn), SV_POSITION from gl_FragCoord (UPPER_LEFT, notas D2).
// App foot of the VS (locations >= 14): the edit views' per-vertex data.
in float maskFactor;
in vec3 weightColor;
flat in int ZappedVert;
uniform bool bHide;
uniform bool bApplyZap;
uniform bool bShowMask;
uniform bool bShowWeight;
uniform bool bShowTexture;
uniform bool bShowVertexColor;   // RenderableMesh.MaterialData.UseVertexColor (the edit view's vertex colour toggle)
uniform bool bWireframe;
uniform vec3 color;              // the shape's Wirecolor (edit view)
uniform vec3 subColor;           // the shape's TintColor (edit view)
layout(location = 0) out vec4 o0;    // RT 0x1A  R8G8B8A8_UNORM_SRGB
layout(location = 1) out vec4 o1;    // RT 0x1B  R16G16_UNORM
layout(location = 2) out vec4 o2;    // RT 0x1D  R8G8B8A8_UNORM
layout(location = 3) out vec4 o3;    // RT 0x1E  R8G8B8A8_UNORM
layout(location = 4) out vec4 o4;    // RT 0x1F  R8G8B8A8_UNORM_SRGB
void main()
{
    Fo4GBufIn vin = gbufFromStageInputs();
    gbufSvPosition = gl_FragCoord.xy;
    bool kill;
    FO4_GBUF_ENTRY(vin, o0, o1, o2, o3, o4, kill);
    // The editor's flat view (app design, rev-36 a; D17 12-oct-2026): the albedo without texture is the edit colour - the vertex
    // colour when the toggle shows it, else 1, times the Wirecolor, times the TintColor outside wireframe - through the VS colour
    // law exp2(2.2 * log2(c)) (rec2288 L119..122). The vertex colour comes already through that law from the engine VS (vin.col0),
    // so the factors go through it apart: exp2(2.2 log2(a b)) = exp2(2.2 log2 a) exp2(2.2 log2 b).
    if (!bShowTexture)
    {
        vec3 e = clamp(color, 0.0, 1.0);
        if (!bWireframe) e *= subColor;
        vec3 eLin = vec3(d3d_exp2(2.2 * d3d_log2(e.r)), d3d_exp2(2.2 * d3d_log2(e.g)), d3d_exp2(2.2 * d3d_log2(e.b)));
        o0.rgb = (bShowVertexColor ? vin.col0.rgb : vec3(1.0)) * eLin;
    }
    if (bShowMask) o0.rgb *= maskFactor;
    if (bShowWeight) o0.rgb *= weightColor;
    if (bHide || (bApplyZap && ZappedVert == 1)) kill = true;
    if (kill) discard;
}
"
    Friend Const EffectAppMain As String = "// APP ENTRY of the BSEffect decals drawn in the G-buffer lists (replaces EFFECT_MAIN). vtex = the uv; vcol = the raw vertex
// colour (the PS applies the 2.2 power); vfog = no fog (0); vlpos = the position the effect lights read (no point lights in
// the preview: their colours are 0, NT8 declared).
in vec2 vUV;
in vec4 vColor;
in vec3 vWorldPos;
flat in int ZappedVert;
uniform vec2 uvScale;
uniform vec2 uvOffset;
uniform bool bHide;
uniform bool bApplyZap;
layout(location = 0) out vec4 o0;     // RT 0x1A (the only target the PS writes; the app masks 1..5)
void main()
{
    vec2 uv = vUV * uvScale + uvOffset;
    bool kill;
    FO4_GDECAL_ENTRY(vec4(uv, 0.0, 0.0), vColor, vec4(0.0), vec4(vWorldPos, 1.0), o0, kill);
    if (bHide || (bApplyZap && ZappedVert == 1)) kill = true;
    if (kill) discard;
}
"
