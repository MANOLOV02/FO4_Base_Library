    ''' <summary>DIVERGENCE (ola 2 ensayo, BC37255): the function texts (PS classes and their FO4_GBUF_IN defines, VS / HS / DS, fxp
    ''' tail, effect decals) are the embedded resource Fo4GBufferBlocks.glsl.txt generated with this module, read once.</summary>
    Friend Function ProgramText(name As String) As String
        Return _blocks.Value(name)
    End Function
    Private ReadOnly _blocks As New Lazy(Of Dictionary(Of String, String))(
        Function()
            Dim d As New Dictionary(Of String, String)(StringComparer.Ordinal)
            Using st = GetType(Fo4GBufferResourceAnchor).Assembly.GetManifestResourceStream("FO4_Base_Library.Fo4GBufferBlocks.glsl.txt")
                If st Is Nothing Then Throw New InvalidOperationException("embedded resource FO4_Base_Library.Fo4GBufferBlocks.glsl.txt missing")
                Using rd As New IO.StreamReader(st, Text.Encoding.ASCII)
                    Dim name As String = Nothing
                    Dim sb As New Text.StringBuilder()
                    Do
                        Dim l = rd.ReadLine()
                        If l Is Nothing Then Exit Do
                        If name Is Nothing Then
                            If l.StartsWith("//#### BEGIN ", StringComparison.Ordinal) Then name = l.Substring(13, l.Length - 18) : sb.Clear()
                        ElseIf l = "//#### END " & name & " ####" Then
                            d(name) = sb.ToString() : name = Nothing
                        Else
                            sb.Append(l).Append(ChrW(10))
                        End If
                    Loop
                    If name IsNot Nothing Then Throw New InvalidOperationException("unterminated block " & name)
                End Using
            End Using
            Return d
        End Function)
    Private NotInheritable Class Fo4GBufferResourceAnchor
    End Class


