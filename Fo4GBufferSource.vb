    ''' <summary>Distinct (VS, HS, DS, PS) tuples of LawTechniques.</summary>
    Friend ReadOnly Property LawTupleCount As Integer
        Get
            Return LawTechniques.Select(Function(t) New Fo4Technique(t).Key()).Distinct().Count()
