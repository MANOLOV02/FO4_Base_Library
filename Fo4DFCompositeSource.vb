layout(std430, binding = 48) readonly buffer Fo4DfcStructT8 { uint dfcst8_words[]; };
int d3d_ld_t8(int element, int stride, int byteOffset)
{
    uint e = uint(element);
    if (e >= (uint(dfcst8_words.length()) * 4u) / uint(stride)) return 0;
    return int(dfcst8_words[(e * uint(stride) + uint(byteOffset)) / 4u]);
}
