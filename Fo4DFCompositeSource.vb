    ''' <summary>The engine's VS of a composite technique (SetupTechnique 0x142216AC0 -&gt; 0x1422741D0): t AND 0xFFE07011.</summary>
    Friend Function VertexShaderId(technique As UInteger) As UInteger
        Return technique And &HFFE07011UI
    End Function

    ''' <summary>The engine's PS of a composite technique (0x1422741E0): (t AND 0xFFFFFBE9) OR (0x1421FA9A0() ? 0x10000 : 0): bit 16
    ''' TILED_LIGHTS when the tiled lighting runs (at least iTiledLightingMinLights lights, 0x1421BE2B6) - <paramref name="tiled"/>.</summary>
    Friend Function PixelShaderId(technique As UInteger, Optional tiled As Boolean = False) As UInteger
        Return (technique And &HFFFFFBE9UI) Or If(tiled, &H10000UI, 0UI)
    End Function

    ''' <summary>The programs of the technique that are NOT in the shader cache, named; Nothing when both are there.</summary>
    Friend Function MissingEnginePrograms(technique As UInteger, Optional tiled As Boolean = False) As String
        Dim ps = PixelShaderId(technique, tiled), vs = VertexShaderId(technique)
        Dim psIn = PixelShaders.ContainsKey(ps), vsIn = VertexStages.ContainsKey(vs)
        If psIn AndAlso vsIn Then Return Nothing
        If Not psIn AndAlso Not vsIn Then Return $"pixel shader 0x{ps:X8} and vertex shader 0x{vs:X8}"
        Return If(psIn, $"vertex shader 0x{vs:X8}", $"pixel shader 0x{ps:X8}")
    End Function

    ''' <summary>The vertex text of VS <paramref name="vs"/>.</summary>
    Friend Function VertexOf(vs As UInteger) As String
        Return Fo4GBufferSource.Header430 & Gl43.ClipGlsl & D3d11SemanticsSource.Glsl & Literals & VertexStages(vs).Resources & VertexStages(vs).Fn & AppVertexFoot
    End Function

    ''' <summary>The fragment text of PS <paramref name="ps"/>, with the app entry (the post's coverage after the record's outputs).</summary>
    Friend Function FragmentOf(ps As UInteger) As String
        Dim p = PixelShaders(ps)
        Return Fo4GBufferSource.Header430 & D3d11SemanticsSource.Glsl & Literals & PsGlobals & p.Resources & p.Fn & p.Entry
    End Function

