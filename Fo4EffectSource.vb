    ''' <summary>The engine's VS of an effect technique (SetupTechnique 0x1422250D0 -&gt; 0x142274F30): t AND 0xB7FF1FFF (drops 13 G2C,
    ''' 14 G2A, 15 IGNORE_TEX_ALPHA, 27 UI_MASK_RECTS, 30 PREMULTIPLY_ALPHA).</summary>
    Friend Function VertexShaderId(technique As UInteger) As UInteger
#If DEBUG Then
        ' ShadowGate --fo4-effect-technique-law's mutant (Fo4GBufferConstants.GateMutantOn, the one switch): bit 12 SOFT dropped too.
        If Fo4GBufferConstants.GateMutantOn("efx-vsid-mask") Then Return technique And &HB7FF0FFFUI
#End If
        Return technique And &HB7FF1FFFUI
    End Function

    ''' <summary>The engine's PS of an effect technique (0x142274F40): SKINNED (bit 1) dropped unless MEMBRANE (bit 9), then AND
    ''' 0xDFFBFFFF (drops 18 SKY_OBJECT and 29 MERGE_INSTANCED).</summary>
    Friend Function PixelShaderId(technique As UInteger) As UInteger
        Dim a = If((technique And &H200UI) <> 0UI, technique, technique And &HFFFFFFFDUI)
        Return a And &HDFFBFFFFUI
    End Function

    ''' <summary>The programs of the technique that are NOT in the shader cache (the source's closed lists PixelShaders / VertexStages),
    ''' named for the frame's notice; Nothing when both are there (BeginTechnique 0x142231AE0 looks both up, no HS / DS: r8 = r9 = 0,
    ''' 0x14222511F..133; SetupTechnique returns 0 and the pass is not drawn, 0x14222513F..145).</summary>
    Friend Function MissingEnginePrograms(technique As UInteger) As String
        Dim ps = PixelShaderId(technique), vs = VertexShaderId(technique)
        Dim psIn = PixelShaders.ContainsKey(ps), vsIn = VertexStages.ContainsKey(vs)
        If psIn AndAlso vsIn Then Return Nothing
        If Not psIn AndAlso Not vsIn Then Return $"pixel shader 0x{ps:X8} and vertex shader 0x{vs:X8}"
        Return If(psIn, $"vertex shader 0x{vs:X8}", $"pixel shader 0x{ps:X8}")
    End Function

    ''' <summary>Why the preview cannot draw technique <paramref name="technique"/> although the engine has its programs: a runtime
    ''' resource one of its stages reads (Gap of the PS / VS); empty when it can.</summary>
    Friend Function GapOf(technique As UInteger) As String
        Dim p = PixelShaders(PixelShaderId(technique)).Gap, v = VertexStages(VertexShaderId(technique)).Gap
        Return If(p <> "" AndAlso v <> "", p & "; " & v, p & v)
    End Function

    ''' <summary>THE ONE RULE of an effect draw's vertex route (as Fo4GBufferSource.EffectiveCpuLayout for the G-buffer): the CPU-route
    ''' layout of VS <paramref name="vs"/> when the draw takes the CPU route, None for a rigid VS or on the GPU route.</summary>
    Friend Function EffectiveCpuLayout(vs As UInteger, cpuRoute As Boolean) As Fo4CpuRouteLayout
        If Not cpuRoute Then Return Fo4CpuRouteLayout.None
        Dim v As (Record As Integer, Fn As String, Resources As String, SkinLaw As Boolean, CpuFn As String, CpuResources As String, CpuSkinLaw As Boolean, CpuLayout As Fo4CpuRouteLayout, Gap As String) = Nothing
        Return If(VertexStages.TryGetValue(vs, v), v.CpuLayout, Fo4CpuRouteLayout.None)
    End Function

    ''' <summary>The vertex text of VS <paramref name="vs"/> on a vertex route (the GPU route blends cb10, the CPU route reads the CPU's
    ''' skinning stream, Fo4EngineVertexPacker.PackCpuRoute): Gl43.ClipGlsl (gl_Position = gl43ClipToGl(o0)), the D3D semantics, the
    ''' literals, AppSkinLaw where rule D2 put it, the resources, the class block and the app foot (<paramref name="surface"/>: the
    ''' foot of the translucent decals' base surface, AppSurfaceVertexFoot). <paramref name="positionCapture"/>: Gl43.ClipGlslCapture
    ''' instead (gl_Position = the D3D clip position o0, for a transform-feedback capture: ShadowGate's effect gates).</summary>
    Friend Function VertexOf(vs As UInteger, cpuRoute As Boolean, Optional surface As Boolean = False, Optional positionCapture As Boolean = False) As String
        Dim v = VertexStages(vs)
        Dim foot = If(surface, AppSurfaceVertexFoot, AppVertexFoot)
        Dim clip = If(positionCapture, Gl43.ClipGlslCapture, Gl43.ClipGlsl)
        If EffectiveCpuLayout(vs, cpuRoute) <> Fo4CpuRouteLayout.None Then
            Return Fo4GBufferSource.Header430 & clip & D3d11SemanticsSource.Glsl & Literals & If(v.CpuSkinLaw, AppSkinLaw.Glsl, "") & v.CpuResources & v.CpuFn & foot
        End If
        Return Fo4GBufferSource.Header430 & clip & D3d11SemanticsSource.Glsl & Literals & If(v.SkinLaw, AppSkinLaw.Glsl, "") & v.Resources & v.Fn & foot
    End Function

    ''' <summary>The fragment text of PS <paramref name="ps"/>: the D3D semantics, the literals, the PS globals the app entry sets, the
    ''' class block and the app entry.</summary>
    Friend Function FragmentOf(ps As UInteger) As String
        Return Fo4GBufferSource.Header430 & D3d11SemanticsSource.Glsl & Literals & PsGlobals & PixelShaders(ps).Fn & AppMain
    End Function


