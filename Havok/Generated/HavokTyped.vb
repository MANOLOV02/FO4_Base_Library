            Get
                If _off Is Nothing OrElse _off(I_CachedBindables) < 0 Then Return 0
                Dim h = _g.ReadArrayHeader(_o + _off(I_CachedBindables))
                Return If(h Is Nothing OrElse h.DataRelativeOffset < 0, 0, h.Count)
            End Get
        End Property
        ''' <summary>
        ''' ⛔ LA DIRECCION DEL ELEMENTO i, NO SU VALOR. Se llamaba `[CachedBindables]Item` y eso
        ''' invitaba a sumarlo como si fuera el dato: `blockOffsets.Add(hkr.BlockOffsetsItem(i))`
        ''' daba 0xED0 donde el bloque arranca en 0. De los 527 accesores que se emitian,
        ''' los dos unicos usos eran ese error.
        ''' <para>El VALOR sale del objeto generado: `HkObj_*.[CachedBindables]` ya devuelve la lista
        ''' leida. Esto queda para quien necesite la direccion.</para>
        ''' </summary>
        Public Function [CachedBindablesItemOffset](i As Integer) As Integer
            If _off Is Nothing OrElse _off(I_CachedBindables) < 0 Then Return -1
            Dim h = _g.ReadArrayHeader(_o + _off(I_CachedBindables))
            If h Is Nothing OrElse i < 0 OrElse i >= h.Count OrElse h.DataRelativeOffset < 0 Then Return -1
            Return h.DataRelativeOffset + (i * 8)
        End Function

