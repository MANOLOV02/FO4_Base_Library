        ''' <para>El VALOR sale del objeto generado: `HkObj_*.[CharacterPoseAtBeginningOfTransition]` ya devuelve la lista
        ''' leida. Esto queda para quien necesite la direccion.</para>
        ''' </summary>
        Public Function [CharacterPoseAtBeginningOfTransitionItemOffset](i As Integer) As Integer
            If _off Is Nothing OrElse _off(I_CharacterPoseAtBeginningOfTransition) < 0 Then Return -1
            Dim h = _g.ReadArrayHeader(_o + _off(I_CharacterPoseAtBeginningOfTransition))
            If h Is Nothing OrElse i < 0 OrElse i >= h.Count OrElse h.DataRelativeOffset < 0 Then Return -1
