    ''' <summary>`hknpWorldSnapshot` - 6 miembros (union de los dos juegos). padre=hkReferencedObject</summary>
    Public Structure Hk_HknpWorldSnapshot
        Private ReadOnly _g As HkxObjectGraph_Class
        Private ReadOnly _o As Integer
        Private ReadOnly _off As Integer()

        ''' <summary>Offsets de FO4. -1 = el miembro no existe en ese juego.</summary>
        Private Shared ReadOnly OFF_FO4 As Integer() = {8, 16, 272, 288, 304, 320}
        ''' <summary>Offsets de SSE. -1 = el miembro no existe en ese juego, o lo declara
        ''' con otra forma y el accesor emitido es el de FO4.</summary>
        Private Shared ReadOnly OFF_SSE As Integer() = {-1, -1, -1, -1, -1, -1}

        Public Sub New(graph As HkxObjectGraph_Class, relativeOffset As Integer)
            _g = graph
            _o = relativeOffset
            _off = HkRead.TablaDe(graph, OFF_FO4, OFF_SSE)
        End Sub

        Public Sub New(graph As HkxObjectGraph_Class, source As HkxVirtualObjectGraph_Class)
            _g = graph
            _o = If(source Is Nothing, 0, source.RelativeOffset)
            _off = HkRead.TablaDe(graph, OFF_FO4, OFF_SSE)
        End Sub

        ''' <summary>False si el packfile no tiene tabla (Skyrim32) o el grafo es Nothing.</summary>
        Public ReadOnly Property IsValid As Boolean
            Get
                Return _g IsNot Nothing AndAlso _off IsNot Nothing
            End Get
        End Property

        ''' <summary>El offset del bloque, o -1 si este lector no es valido.
        ''' <para>⛔ EL -1 NO ES DECORACION. `HkObj_X.ReadAt(_g, _r.[Y].BaseOffset)` es como el
        ''' objeto generado baja a un struct embebido, y `ReadAt` acepta todo offset >= 0: con un
        ''' lector invalido devolviendo 0 se construye un objeto que lee la CABEZA de la seccion y
        ''' entrega numeros plausibles. -1 hace que `ReadAt` devuelva Nothing, que es lo que
        ''' corresponde.</para></summary>
        Public ReadOnly Property BaseOffset As Integer
            Get
                If _g Is Nothing OrElse _off Is Nothing Then Return -1
                Return _o
            End Get
        End Property

