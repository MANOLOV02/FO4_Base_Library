    ''' <summary>Helpers de lectura compartidos por todos los lectores generados.</summary>
    Friend Module HkRead
        ''' <summary>int8 con signo: ReadByte devuelve 0..255 y hay que reinterpretarlo.</summary>
        Friend Function SByteAt(g As HkxObjectGraph_Class, at As Integer) As Integer
            Dim b = CInt(g.ReadByte(at))
            Return If(b > 127, b - 256, b)
        End Function

        ''' <summary>half IEEE-754 (1 signo / 5 exponente / 10 mantisa).</summary>
        Friend Function HalfAt(g As HkxObjectGraph_Class, at As Integer) As Single
            ' ⛔ MASCARA, NO `CUShort`: un half con el bit de signo puesto es un Short NEGATIVO
            ' y `CUShort` de un negativo TIRA. Ver el encabezado del generador.
            Dim bits = CInt(g.ReadInt16(at)) And &HFFFF
            Dim sgn = (bits >> 15) And 1
            Dim ex = (bits >> 10) And &H1F
            Dim man = bits And &H3FF
            Dim v As Single
            If ex = 0 Then
                v = CSng(man * Math.Pow(2, -24))
            ElseIf ex = 31 Then
                v = If(man = 0, Single.PositiveInfinity, Single.NaN)
            Else
                v = CSng((1024 + man) * Math.Pow(2, ex - 25))
            End If
            Return If(sgn <> 0, -v, v)
        End Function

        ''' <summary>Entero de 64 bits: el grafo expone lecturas de 32, se arma con dos.</summary>
        Friend Function Int64At(g As HkxObjectGraph_Class, at As Integer) As Long
            Return CLng(g.ReadUInt32(at)) Or (CLng(g.ReadUInt32(at + 4)) << 32)
        End Function

        ''' <summary>n floats consecutivos (vector4, quaternion, transform, matrices).</summary>
        Friend Function FloatsAt(g As HkxObjectGraph_Class, at As Integer, n As Integer) As Single()
            Dim r(n - 1) As Single
            For i = 0 To n - 1
                r(i) = g.ReadSingle(at + (i * 4))
            Next
            Return r
        End Function

        ''' <summary>
        ''' Elige la tabla de offsets segun lo que el PACKFILE declara. Es el unico lugar del
        ''' lector tipado donde se decide el juego, y la decision NO mira la config del usuario:
        ''' `Config_App.Game` viene en Skyrim por defecto y usarlo aca leeria un HKX de Fallout
        ''' con los offsets equivocados.
        ''' <para>Se compara el ENUM del formato y no el Tag como texto: esto corre UNA VEZ POR
        ''' LECTOR CONSTRUIDO, y al materializar una lista se construye un lector por elemento.
        ''' Una comparacion de String ahi son millones de comparaciones en un barrido.</para>
        ''' </summary>
        Friend Function TablaDe(g As HkxObjectGraph_Class, offFo4 As Integer(), offSse As Integer()) As Integer()
            ' ⛔ EL FORMATO LO DECLARA EL GRAFO, NO LA CABECERA. Mirando `Packfile.Header` el lector
            ' no podia leer la CABECERA: para elegir tabla necesitaba la cabecera ya parseada. El
            ' grafo de arranque trae el formato derivado de fileVersion+pointerSize, dos campos que
            ' las dos tablas declaran en el MISMO offset (0xC y 0x10), asi que se leen sin elegir.
            If g Is Nothing Then Return Nothing
            Select Case g.Formato
                Case HkxPackfileFormat_Enum.Fallout64
                    Return offFo4
                Case HkxPackfileFormat_Enum.Skyrim64
                    Return offSse
                Case Else
                    Return Nothing
            End Select
        End Function
