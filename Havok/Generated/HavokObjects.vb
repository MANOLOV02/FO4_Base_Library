        Public Shared Function Todos(graph As HkxObjectGraph_Class) As List(Of HkObj_HkbLookAtModifier)
            Dim r As New List(Of HkObj_HkbLookAtModifier)()
            If graph Is Nothing Then Return r
            For Each _genB In graph.GetObjectsByClassName(NombreDeClase)
                Dim _genO = Read(graph, _genB)
                If _genO IsNot Nothing Then r.Add(_genO)
            Next
            Return r
        End Function

