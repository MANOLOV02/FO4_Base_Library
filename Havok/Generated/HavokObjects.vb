            Try : d("restitutionCombinePolicy") = Me.[RestitutionCombinePolicy] : _genL?.Add("restitutionCombinePolicy") : Catch : d("restitutionCombinePolicy") = Nothing : End Try
            Try : d("weldingTolerance") = Me.[WeldingTolerance] : _genL?.Add("weldingTolerance") : Catch : d("weldingTolerance") = Nothing : End Try
            Try : d("maxContactImpulse") = Me.[MaxContactImpulse] : _genL?.Add("maxContactImpulse") : Catch : d("maxContactImpulse") = Nothing : End Try
            Try : d("fractionOfClippedImpulseToApply") = Me.[FractionOfClippedImpulseToApply] : _genL?.Add("fractionOfClippedImpulseToApply") : Catch : d("fractionOfClippedImpulseToApply") = Nothing : End Try
            Try : d("massChangerCategory") = Me.[MassChangerCategory] : _genL?.Add("massChangerCategory") : Catch : d("massChangerCategory") = Nothing : End Try
            Try : d("massChangerHeavyObjectFactor") = Me.[MassChangerHeavyObjectFactor] : _genL?.Add("massChangerHeavyObjectFactor") : Catch : d("massChangerHeavyObjectFactor") = Nothing : End Try
