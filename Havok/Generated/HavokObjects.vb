        ''' <summary>`states` array&lt;pointer&gt;</summary>
        Private _states_c As List(Of HkObj_HkbStateMachineStateInfo)
        ''' <summary>Elementos ya materializados. Perezoso: no recorre nada hasta que se pide.</summary>
        Public ReadOnly Property [States] As List(Of HkObj_HkbStateMachineStateInfo)
            Get
                If _states_c Is Nothing Then
                    _states_c = New List(Of HkObj_HkbStateMachineStateInfo)()
                    Dim _genHdr = _r.[States]
                    If _genHdr IsNot Nothing AndAlso _genHdr.DataRelativeOffset >= 0 Then
                        Dim _genPaso = _r.[StatesPaso]
                        For i = 0 To _genHdr.Count - 1
                            Dim _genOff = _genHdr.DataRelativeOffset + (i * _genPaso)
                            Dim o = HkObj_HkbStateMachineStateInfo.Read(_g, _g.ResolveGlobalObject(_genOff))
                            If o IsNot Nothing Then _states_c.Add(o)
                        Next
                    End If
                End If
                Return _states_c
            End Get
        End Property

