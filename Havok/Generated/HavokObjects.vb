        ''' <summary>Lee el objeto. Nothing si el grafo o el objeto no son validos.</summary>
        Public Shared Function Read(graph As HkxObjectGraph_Class, source As HkxVirtualObjectGraph_Class) As HkObj_HkbBehaviorGraphData
            If graph Is Nothing OrElse source Is Nothing Then Return Nothing
            Return New HkObj_HkbBehaviorGraphData(graph, source.RelativeOffset, source)
        End Function

        Public Shared Function ReadAt(graph As HkxObjectGraph_Class, relativeOffset As Integer) As HkObj_HkbBehaviorGraphData
            If graph Is Nothing OrElse relativeOffset < 0 Then Return Nothing
            Return New HkObj_HkbBehaviorGraphData(graph, relativeOffset, Nothing)
        End Function

