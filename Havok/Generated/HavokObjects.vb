            Try : d("nodeInfo") = Me.[NodeInfo] : _genL?.Add("nodeInfo") : Catch : d("nodeInfo") = Nothing : End Try
            Try : d("enable") = Me.[Enable] : _genL?.Add("enable") : Catch : d("enable") = Nothing : End Try
            Try : d("padModifier") = Me.[PadModifier] : _genL?.Add("padModifier") : Catch : d("padModifier") = Nothing : End Try
            Try : d("sendToAttacherOnAttach") = Me.[SendToAttacherOnAttach] : _genL?.Add("sendToAttacherOnAttach") : Catch : d("sendToAttacherOnAttach") = Nothing : End Try
            Try : d("sendToAttacheeOnAttach") = Me.[SendToAttacheeOnAttach] : _genL?.Add("sendToAttacheeOnAttach") : Catch : d("sendToAttacheeOnAttach") = Nothing : End Try
            Try : d("sendToAttacherOnDetach") = Me.[SendToAttacherOnDetach] : _genL?.Add("sendToAttacherOnDetach") : Catch : d("sendToAttacherOnDetach") = Nothing : End Try
            Try : d("sendToAttacheeOnDetach") = Me.[SendToAttacheeOnDetach] : _genL?.Add("sendToAttacheeOnDetach") : Catch : d("sendToAttacheeOnDetach") = Nothing : End Try
            Try : d("attachmentSetup") = Me.[AttachmentSetup] : _genL?.Add("attachmentSetup") : Catch : d("attachmentSetup") = Nothing : End Try
