        ''' <summary>El nombre que la reflexion del .exe le da a esta clase.</summary>
        Public Const NombreDeClase As String = "hkbClientCharacterState"

        ''' <summary>
        ''' Lee el bloque SI DECLARA esta clase o DERIVA de ella. Nothing si no.
        ''' <para>⛔ LA HERENCIA ES DEL MOTOR, NO UNA COMODIDAD. Havok resuelve el puntero
        ''' por vtable: un campo declarado `hclShape*` trae un `hclCapsuleShape`. La reflexion
        ''' declara el padre de cada clase y `HavokLayout.DerivaDe` sube la cadena.</para>
        ''' <para>⛔ COMPARACION EXACTA, NO `OrdinalIgnoreCase`. Medido sobre los dos corpus:
        ''' 166 clases distintas y CERO con mayuscula distinta a la reflexion. Lo insensible
        ''' era una muleta de `NombreHavokDe`, que derivaba el nombre del NOMBRE DEL TIPO y
        ''' no podia recuperar la mayuscula inicial. Emitido desde la tabla, se sabe.</para>
        ''' </summary>
        Public Shared Function Leer(graph As HkxObjectGraph_Class, source As HkxVirtualObjectGraph_Class) As HkObj_HkbClientCharacterState
            If graph Is Nothing OrElse source Is Nothing Then Return Nothing
            If String.Equals(source.ClassName, NombreDeClase, StringComparison.Ordinal) Then Return Read(graph, source)
            Dim lay = HavokLayout.ForGraph(graph)
            If lay Is Nothing OrElse Not lay.DerivaDe(source.ClassName, NombreDeClase) Then Return Nothing
            Return Read(graph, source)
        End Function

        ''' <summary>Los bloques que declaran esta clase, leidos, en el orden del archivo.</summary>
        Public Shared Function Todos(graph As HkxObjectGraph_Class) As List(Of HkObj_HkbClientCharacterState)
            Dim r As New List(Of HkObj_HkbClientCharacterState)()
            If graph Is Nothing Then Return r
            For Each _genB In graph.GetObjectsByClassName(NombreDeClase)
                Dim _genO = Read(graph, _genB)
                If _genO IsNot Nothing Then r.Add(_genO)
            Next
            Return r
        End Function

        ''' <summary>
        ''' El valor de cada miembro, POR EL NOMBRE QUE DECLARA LA REFLEXION.
        ''' <para>⛔ EMITIDO. `HavokObjetoGenerico` lo armaba con `t.GetProperties()` +
        ''' `p.GetValue(o)` y quedaba indexado por el nombre VB de la propiedad, no por el del
        ''' motor. El que falla se anota en Nothing y NO entra a `leidos`: un campo ilegible no
        ''' puede tumbar el objeto entero, y un censo de cobertura solo puede equivocarse
        ''' hacia arriba.</para></summary>
        Public Function Campos(Optional leidos As List(Of String) = Nothing) As Dictionary(Of String, Object)
            Dim d As New Dictionary(Of String, Object)(StringComparer.OrdinalIgnoreCase)
            Dim _genL = leidos
            Try : d("memSizeAndRefCount") = Me.[MemSizeAndRefCount] : _genL?.Add("memSizeAndRefCount") : Catch : d("memSizeAndRefCount") = Nothing : End Try
            Try : d("deformableSkinIds") = Me.[DeformableSkinIds] : _genL?.Add("deformableSkinIds") : Catch : d("deformableSkinIds") = Nothing : End Try
            Try : d("rigidSkinIds") = Me.[RigidSkinIds] : _genL?.Add("rigidSkinIds") : Catch : d("rigidSkinIds") = Nothing : End Try
            Try : d("externalEventIds") = Me.[ExternalEventIds] : _genL?.Add("externalEventIds") : Catch : d("externalEventIds") = Nothing : End Try
            Try : d("auxiliaryInfo") = Me.[AuxiliaryInfo] : _genL?.Add("auxiliaryInfo") : Catch : d("auxiliaryInfo") = Nothing : End Try
            Try : d("activeEventIds") = Me.[ActiveEventIds] : _genL?.Add("activeEventIds") : Catch : d("activeEventIds") = Nothing : End Try
            Try : d("activeVariableIds") = Me.[ActiveVariableIds] : _genL?.Add("activeVariableIds") : Catch : d("activeVariableIds") = Nothing : End Try
            Try : d("characterId") = Me.[CharacterId] : _genL?.Add("characterId") : Catch : d("characterId") = Nothing : End Try
            Try : d("instanceName") = Me.[InstanceName] : _genL?.Add("instanceName") : Catch : d("instanceName") = Nothing : End Try
            Try : d("templateName") = Me.[TemplateName] : _genL?.Add("templateName") : Catch : d("templateName") = Nothing : End Try
            Try : d("fullPathToProject") = Me.[FullPathToProject] : _genL?.Add("fullPathToProject") : Catch : d("fullPathToProject") = Nothing : End Try
            Try : d("localScriptsPath") = Me.[LocalScriptsPath] : _genL?.Add("localScriptsPath") : Catch : d("localScriptsPath") = Nothing : End Try
            Try : d("remoteScriptsPath") = Me.[RemoteScriptsPath] : _genL?.Add("remoteScriptsPath") : Catch : d("remoteScriptsPath") = Nothing : End Try
            Try : d("behaviorData") = Me.[BehaviorData] : _genL?.Add("behaviorData") : Catch : d("behaviorData") = Nothing : End Try
            Try : d("behaviorInternalState") = Me.[BehaviorInternalState] : _genL?.Add("behaviorInternalState") : Catch : d("behaviorInternalState") = Nothing : End Try
            Try : d("nodeIdToInternalStateMap") = Me.[NodeIdToInternalStateMap] : _genL?.Add("nodeIdToInternalStateMap") : Catch : d("nodeIdToInternalStateMap") = Nothing : End Try
            Try : d("visible") = Me.[Visible] : _genL?.Add("visible") : Catch : d("visible") = Nothing : End Try
            Try : d("elapsedSimulationTime") = Me.[ElapsedSimulationTime] : _genL?.Add("elapsedSimulationTime") : Catch : d("elapsedSimulationTime") = Nothing : End Try
            Try : d("skeleton") = Me.[Skeleton] : _genL?.Add("skeleton") : Catch : d("skeleton") = Nothing : End Try
            Try : d("worldFromModel") = Me.[WorldFromModel] : _genL?.Add("worldFromModel") : Catch : d("worldFromModel") = Nothing : End Try
            Try : d("poseModelSpace") = Me.[PoseModelSpace] : _genL?.Add("poseModelSpace") : Catch : d("poseModelSpace") = Nothing : End Try
            Try : d("rigidAttachmentTransforms") = Me.[RigidAttachmentTransforms] : _genL?.Add("rigidAttachmentTransforms") : Catch : d("rigidAttachmentTransforms") = Nothing : End Try
