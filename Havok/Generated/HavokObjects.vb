        ''' <summary>Los bloques que apunta cada elemento. La reflexion no declara la clase
        ''' destino; la dice el bloque. Perezoso: no resuelve nada hasta que se pide.</summary>
        Public ReadOnly Property [CachedBindables] As List(Of HkxVirtualObjectGraph_Class)
            Get
                If _cachedbindables_c Is Nothing Then
                    _cachedbindables_c = New List(Of HkxVirtualObjectGraph_Class)()
                    Dim _genHdr = _r.[CachedBindables]
                    If _genHdr IsNot Nothing AndAlso _genHdr.DataRelativeOffset >= 0 Then
                        Dim _genPaso = _r.[CachedBindablesPaso]
                        For i = 0 To _genHdr.Count - 1
                            ' ⛔⛔ Solo los que RESOLVIERON: el indice de la lista NO es
                            ' el del arreglo del archivo, y `Count` no es el que declara la
                            ' cabecera. Las ranuras sin fixup se saltean.
                            Dim _genRef = _g.ResolveGlobalObject(_genHdr.DataRelativeOffset + (i * _genPaso))
                            If _genRef IsNot Nothing Then _cachedbindables_c.Add(_genRef)
                        Next
                    End If
                End If
                Return _cachedbindables_c
            End Get
        End Property

