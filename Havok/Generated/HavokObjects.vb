        ''' <summary>`phantoms` array&lt;pointer&gt;</summary>
        Private _phantoms_c As List(Of HkObj_HkpPhantom)
        ''' <summary>Elementos ya materializados. Perezoso: no recorre nada hasta que se pide.</summary>
        Public ReadOnly Property [Phantoms] As List(Of HkObj_HkpPhantom)
            Get
                If _phantoms_c Is Nothing Then
                    _phantoms_c = New List(Of HkObj_HkpPhantom)()
                    For i = 0 To _r.[PhantomsCount] - 1
                        Dim o = HkObj_HkpPhantom.Read(_g, _r.[PhantomsRef](i))
                        If o IsNot Nothing Then _phantoms_c.Add(o)
                    Next
                End If
                Return _phantoms_c
            End Get
        End Property

