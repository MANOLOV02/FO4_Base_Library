            Try : d("tau") = Me.[Tau] : _genL?.Add("tau") : Catch : d("tau") = Nothing : End Try
            Try : d("damping") = Me.[Damping] : _genL?.Add("damping") : Catch : d("damping") = Nothing : End Try
            Try : d("proportionalRecoveryVelocity") = Me.[ProportionalRecoveryVelocity] : _genL?.Add("proportionalRecoveryVelocity") : Catch : d("proportionalRecoveryVelocity") = Nothing : End Try
            Try : d("constantRecoveryVelocity") = Me.[ConstantRecoveryVelocity] : _genL?.Add("constantRecoveryVelocity") : Catch : d("constantRecoveryVelocity") = Nothing : End Try
            Try : d("memSizeAndFlags") = Me.[MemSizeAndFlags] : _genL?.Add("memSizeAndFlags") : Catch : d("memSizeAndFlags") = Nothing : End Try
