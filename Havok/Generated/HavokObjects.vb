        Public Const NombreDeClase As String = "hkpWorldCinfo"

        ''' <summary>
        ''' Lee el bloque SI DECLARA esta clase o DERIVA de ella. Nothing si no.
        ''' <para>⛔ LA HERENCIA ES DEL MOTOR, NO UNA COMODIDAD. Havok resuelve el puntero
        ''' por vtable: un campo declarado `hclShape*` trae un `hclCapsuleShape`. La reflexion
        ''' declara el padre de cada clase y `HavokLayout.DerivaDe` sube la cadena.</para>
        ''' <para>⛔ COMPARACION EXACTA, NO `OrdinalIgnoreCase`. Medido sobre los dos corpus:
        ''' 166 clases distintas y CERO con mayuscula distinta a la reflexion. Lo insensible
        ''' era una muleta de `NombreHavokDe`, que derivaba el nombre del NOMBRE DEL TIPO y
        ''' no podia recuperar la mayuscula inicial. Emitido desde la tabla, se sabe.</para>
        ''' </summary>
        Public Shared Function Leer(graph As HkxObjectGraph_Class, source As HkxVirtualObjectGraph_Class) As HkObj_HkpWorldCinfo
            If graph Is Nothing OrElse source Is Nothing Then Return Nothing
            If String.Equals(source.ClassName, NombreDeClase, StringComparison.Ordinal) Then Return Read(graph, source)
            Dim lay = HavokLayout.ForGraph(graph)
            If lay Is Nothing OrElse Not lay.DerivaDe(source.ClassName, NombreDeClase) Then Return Nothing
            Return Read(graph, source)
        End Function

        ''' <summary>Los bloques que declaran esta clase, leidos, en el orden del archivo.</summary>
        Public Shared Function Todos(graph As HkxObjectGraph_Class) As List(Of HkObj_HkpWorldCinfo)
            Dim r As New List(Of HkObj_HkpWorldCinfo)()
            If graph Is Nothing Then Return r
            For Each _genB In graph.GetObjectsByClassName(NombreDeClase)
                Dim _genO = Read(graph, _genB)
                If _genO IsNot Nothing Then r.Add(_genO)
            Next
            Return r
        End Function

