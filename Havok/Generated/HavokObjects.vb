            Try : d("enable") = Me.[Enable] : _genL?.Add("enable") : Catch : d("enable") = Nothing : End Try
            Try : d("padModifier") = Me.[PadModifier] : _genL?.Add("padModifier") : Catch : d("padModifier") = Nothing : End Try
            Try : d("handleOut") = Me.[HandleOut] : _genL?.Add("handleOut") : Catch : d("handleOut") = Nothing : End Try
            Try : d("localFrameName") = Me.[LocalFrameName] : _genL?.Add("localFrameName") : Catch : d("localFrameName") = Nothing : End Try
            Try : d("ragdollBoneIndex") = Me.[RagdollBoneIndex] : _genL?.Add("ragdollBoneIndex") : Catch : d("ragdollBoneIndex") = Nothing : End Try
            Try : d("animationBoneIndex") = Me.[AnimationBoneIndex] : _genL?.Add("animationBoneIndex") : Catch : d("animationBoneIndex") = Nothing : End Try
