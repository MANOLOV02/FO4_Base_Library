        ''' <summary>`tipo|ancho` en hexadecimal: la tabla de anchos del layout x64.
        ''' <para>⛔ SE EMITE POR LA MISMA RAZON QUE LOS TAMANOS DE CLASE. `SizeOfType` estaba
        ''' transcrita a mano en VB, se borro al unificar, y el instrumento que coteja strides
        ''' termino escribiendo su propia version reducida (`16 para array, 8 para el resto`)
        ''' adentro del gate. Una ley, un lugar.</para></summary>
        Private ReadOnly TIPOS As String() = {
            "array|10",
            "bool|1",
            "char|1",
            "cstring|8",
            "half|2",
            "int16|2",
            "int32|4",
            "int64|8",
            "int8|1",
            "matrix3|30",
            "matrix4|40",
            "pointer|8",
            "qstransform|30",
            "quaternion|10",
            "real|4",
            "relarray|4",
            "rotation|30",
            "simplearray|C",
            "stringptr|8",
            "transform|40",
            "uint16|2",
            "uint32|4",
            "uint64|8",
            "uint8|1",
            "ulong|8",
            "variant|10",
            "vector4|10",
            "void|0"
        }

        Private ReadOnly _tipos As Dictionary(Of String, Integer) = CargarTipos()

        ''' <summary>El ancho de un tipo declarado, o -1 si no es uno de los del layout.</summary>
        Friend Function AnchoDeTipo(tipo As String) As Integer
            If String.IsNullOrEmpty(tipo) Then Return -1
            Dim n As Integer
            If _tipos.TryGetValue(tipo, n) Then Return n
            Return -1
        End Function

        Private Function CargarTipos() As Dictionary(Of String, Integer)
            Dim d As New Dictionary(Of String, Integer)(StringComparer.OrdinalIgnoreCase)
            For Each f In TIPOS
                Dim p = f.Split("|"c)
                If p.Length <> 2 Then Continue For
                Dim n As Integer
                If Integer.TryParse(p(1), Globalization.NumberStyles.HexNumber,
                                    Globalization.CultureInfo.InvariantCulture, n) Then d(p(0)) = n
            Next
            Return d
        End Function

        Private ReadOnly _fo4 As Dictionary(Of String, Integer) = Cargar(1)
        Private ReadOnly _sse As Dictionary(Of String, Integer) = Cargar(2)

        ''' <summary>La tabla del juego que pide el llamador. `Tag` es el de `HavokLayout`.
        ''' <para>⛔ `Nothing` PARA UN TAG DESCONOCIDO, igual que `HkRead.TablaDe` y que
        ''' `HavokLayout.For`. Mandar lo que no se reconoce a FO4 en silencio deja dos respuestas
        ''' distintas para la misma pregunta en el mismo subsistema.</para></summary>
        Friend Function Para(tag As String) As Dictionary(Of String, Integer)
            Select Case tag
                Case "FO4" : Return _fo4
                Case "SSE" : Return _sse
                Case Else : Return Nothing
            End Select
        End Function

        Private Function Cargar(col As Integer) As Dictionary(Of String, Integer)
            Dim d As New Dictionary(Of String, Integer)(StringComparer.OrdinalIgnoreCase)
            For Each f In FILAS
                Dim p = f.Split("|"c)
                If p.Length <> 3 Then Continue For
                Dim n As Integer
                If Integer.TryParse(p(col), Globalization.NumberStyles.HexNumber,
                                    Globalization.CultureInfo.InvariantCulture, n) Then d(p(0)) = n
            Next
            Return d
        End Function

    End Module

